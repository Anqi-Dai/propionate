# --- R / RStudio session cruft ---
.Rproj.user
.Rhistory
.RData
.Ruserdata

# --- macOS ---
.DS_Store

# --- renv ---
# The lockfile (renv.lock) and renv/activate.R ARE tracked; the installed library is
# not, since it is machine-specific and is rebuilt with renv::restore().
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/sandbox/
renv/host-info.json
renv/state.json
renv/python/

# --- Knitted notebook output ---
# Regenerated by knitting scripts/01_kate_propionate_pw.Rmd
scripts/*.html
scripts/*.md
scripts/*_files/
scripts/*_cache/
# knitr::knit() (as opposed to rmarkdown::render()) drops plots here
scripts/figure/

# --- Generated figures and tables ---
# Everything in results/ is produced by the analysis script. The folder itself is
# kept (see results/.gitkeep) because the script writes into it.
results/*
!results/.gitkeep

# --- Generated inputs for PICRUSt2 ---
# Built by the "Preparing the PICRUSt2 inputs" chunks from the raw files in data/.
data/derived/

# --- Large PICRUSt2 files that are downloaded, not versioned ---
# The stratified contribution tables are ~40 MB each and the full PICRUSt2 output
# archive is ~680 MB. See the README for the download link.
data/picrust2_out_*/pathways_out/path_abun_contrib.tsv.gz
*.zip

# --- Figures accidentally written into data/ by older versions of the script ---
# The script now writes all figures to results/.
data/*.pdf

# --- Generated PICRUSt2 count tables ---
# Built from the tracked *_ASV_Abundance_Table.csv files by the input-prep chunk,
# never read back by the analysis. The script now writes them to data/derived/.
data/*_ASV_Abundance_Table.tsv
